{
  "name": "codebase-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/copy-manifest.mjs && node scripts/assert-bundle.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json",
    "lint:fast": "oxlint --deny-warnings",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint:fast && npm run lint && npm run test && npm run build",
    "install:vault": "node --env-file-if-exists=.env scripts/install-to-vault.mjs"
  },
  "dependencies": {
    "pinia": "4.0.3",
    "three": "0.186.0",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-vue": "10.11.0",
    "jsdom": "30.1.0",
    "obsidian": "1.13.1",
    "oxlint": "1.83.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
