{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codebase Inspector demo snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "source": {
      "enum": [
        "synthetic",
        "imported"
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Unique repository-relative path. No absolute paths, dot segments, control characters, or empty segments."
          },
          "lines": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "category": {
            "enum": [
              "TypeScript",
              "JavaScript",
              "Vue",
              "Tests",
              "Styles",
              "JSON",
              "Markdown",
              "Other"
            ]
          }
        }
      }
    }
  }
}
